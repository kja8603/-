# ──────────────────────────────────────────────────────────
# .env.example — 이 파일을 복사해 .env 로 저장하고 값을 채우세요.
# cp .env.example .env
# ──────────────────────────────────────────────────────────

# ── Instagram Graph API ────────────────────────────────────
# Meta Business Suite → Instagram 계정 설정 → API 에서 확인
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# ── ImgBB 이미지 호스팅 (Instagram Graph API는 공개 URL 필요) ──
# https://api.imgbb.com/ 에서 무료 API Key 발급
IMGBB_API_KEY=your_imgbb_api_key
